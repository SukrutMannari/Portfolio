---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import { SITE } from '../data/site';
import AIGuide from '../components/AIGuide.astro';

interface Props {
  title?: string;
  description?: string;
  useModelViewer?: boolean;
  usePyScript?: boolean;
}
const { title, description = SITE.description, useModelViewer = false, usePyScript = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — Aspiring Aerospace & CS Engineer`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/images/SukrutHeadshot.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {useModelViewer && (
      <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js" is:inline></script>
    )}
    {usePyScript && (
      <>
        <link rel="stylesheet" href="https://pyscript.net/releases/2024.1.1/core.css" />
        <script type="module" src="https://pyscript.net/releases/2024.1.1/core.js" is:inline></script>
      </>
    )}
    <ViewTransitions />
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const setTheme = () => {
        if (getTheme() === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      };

      setTheme();
      document.addEventListener('astro:after-swap', setTheme);
    </script>
  </head>
  <body>
    <!-- Edit-preview toggle: hidden for visitors; appears only when ?edit is in the URL. -->
    <div class="edit-toggle" id="editBtn" title="Toggle edit-preview mode">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        ><path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg
      >
    </div>

    <div class="wrap">
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <script is:inline>
      // Edit-preview is a private authoring aid, not a visitor feature.
      // Visit any page with ?edit appended (e.g. /about?edit) to enable it.
      (function () {
        const btn = document.getElementById('editBtn');
        if (!btn) return;
        if (new URLSearchParams(location.search).has('edit')) {
          btn.classList.add('available');
          btn.addEventListener('click', () => {
            const on = document.body.classList.toggle('editing');
            btn.classList.toggle('on', on);
            document.querySelectorAll('[data-edit]').forEach((e) =>
              e.setAttribute('contenteditable', String(on))
            );
          });
        }
      })();
    </script>
    <AIGuide />
    
    <!-- Lightbox Overlay -->
    <div id="lightbox-overlay">
      <button id="lightbox-close">&times;</button>
      <img id="lightbox-img" src="" alt="Zoomed Image" />
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const overlay = document.getElementById('lightbox-overlay');
        const lbImg = document.getElementById('lightbox-img');
        const closeBtn = document.getElementById('lightbox-close');
        let activeThumb = null;

        document.body.addEventListener('click', (e) => {
          if (e.target.tagName === 'IMG' && !e.target.closest('#lightbox-overlay') && !e.target.closest('.arcade')) {
            if (e.target.clientWidth < 100) return;
            activeThumb = e.target;
            
            // 1. First (record initial state of thumbnail)
            const firstRect = activeThumb.getBoundingClientRect();
            
            // 2. Set src and display overlay to get final state
            lbImg.src = activeThumb.src;
            overlay.style.display = 'flex';
            
            // Wait for image to load to get its natural aspect ratio
            lbImg.onload = () => {
              // 3. Last (record final state in center of screen)
              const lastRect = lbImg.getBoundingClientRect();
              
              // 4. Invert (apply transform to match first state)
              const scaleX = firstRect.width / lastRect.width;
              const scaleY = firstRect.height / lastRect.height;
              
              // We use transform-origin top left, so we just calculate translation to top left
              const translateX = firstRect.left - lastRect.left;
              const translateY = firstRect.top - lastRect.top;
              
              lbImg.style.transition = 'none';
              lbImg.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scaleX}, ${scaleY})`;
              
              // Force reflow
              lbImg.offsetWidth; 
              
              // 5. Play (animate to center)
              lbImg.style.transition = 'transform 0.4s cubic-bezier(0.2, 0, 0.2, 1)';
              lbImg.style.transform = 'translate(0, 0) scale(1)';
              overlay.classList.add('active');
            };
            
            // Trigger onload if already cached
            if (lbImg.complete) lbImg.onload();
          }
        });

        const closeLightbox = () => {
          if (activeThumb) {
            // Animate back to thumbnail
            const firstRect = activeThumb.getBoundingClientRect();
            
            // Get current un-transformed rect of the lightbox image
            lbImg.style.transition = 'none';
            lbImg.style.transform = 'translate(0,0) scale(1)';
            const lastRect = lbImg.getBoundingClientRect();
            
            const scaleX = firstRect.width / lastRect.width;
            const scaleY = firstRect.height / lastRect.height;
            const translateX = firstRect.left - lastRect.left;
            const translateY = firstRect.top - lastRect.top;
            
            // Re-apply transition and animate
            lbImg.offsetWidth; // reflow
            lbImg.style.transition = 'transform 0.4s cubic-bezier(0.2, 0, 0.2, 1)';
            lbImg.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scaleX}, ${scaleY})`;
          }
          
          overlay.classList.remove('active');
          setTimeout(() => {
            if (!overlay.classList.contains('active')) {
              overlay.style.display = 'none';
              lbImg.src = '';
            }
          }, 400);
        };
        
        closeBtn.addEventListener('click', closeLightbox);
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) closeLightbox();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && overlay.classList.contains('active')) {
            closeLightbox();
          }
        });
      });
    </script>
  </body>
</html>
