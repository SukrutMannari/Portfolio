---
import { NAV } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<div class="macos-dock-container">
  <div class="macos-dock">
    {
      NAV.map((item, i) => (
        <a
          class:list={['dock-item', { active: isActive(item.href) }]}
          href={item.href}
          data-astro-reload={false}
        >
          <div class="dock-tooltip">{item.label}</div>
          <div class="dock-icon">
            {item.label.substring(0, 1).toUpperCase()}
          </div>
          <div class="dock-indicator"></div>
        </a>
      ))
    }
  </div>
</div>

<style is:global>
  .macos-dock-container {
    position: fixed;
    top: 50%;
    left: 24px;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    z-index: 9999;
    pointer-events: none;
  }
  
  .macos-dock {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 14px 10px;
    background: rgba(30, 41, 59, 0.4);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    pointer-events: auto;
    transition: transform 0.2s ease;
  }

  .dock-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    transition: all 0.2s cubic-bezier(0.2, 0, 0.2, 1);
    transform-origin: left center;
    text-decoration: none;
  }

  /* Mac OS Dock Magnification Simulation (Vertical) */
  .dock-item:hover {
    width: 56px !important;
    height: 56px !important;
    transform: translateX(5px);
    z-index: 10;
  }
  .dock-item:has(+ .dock-item:hover),
  .dock-item:hover + .dock-item {
    width: 50px !important;
    height: 50px !important;
    transform: translateX(2px);
  }

  .dock-icon {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    transition: all 0.2s;
  }
  .dock-item:hover .dock-icon {
    box-shadow: 0 8px 20px rgba(0,0,0,0.4);
    background: linear-gradient(135deg, rgba(255,255,255,0.2), rgba(255,255,255,0.05));
    border-color: rgba(255,255,255,0.3);
  }

  .dock-tooltip {
    position: absolute;
    left: 65px;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(4px);
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.2s;
    white-space: nowrap;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .dock-item:hover .dock-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  .dock-indicator {
    position: absolute;
    left: -12px;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 16px;
    border-radius: 4px;
    background: var(--blue);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .dock-item.active .dock-indicator { opacity: 1; }

  /* Genie Animation Keyframes */
  @keyframes genie-out {
    0% { transform: scale(1) translateY(0); opacity: 1; }
    50% { transform: scale(0.6) translateY(200px) skewX(20deg); opacity: 0.5; }
    100% { transform: scale(0.1) translateY(400px) skewX(0); opacity: 0; }
  }
  @keyframes genie-in {
    0% { transform: scale(0.1) translateY(400px) skewX(0); opacity: 0; }
    50% { transform: scale(0.6) translateY(200px) skewX(-20deg); opacity: 0.5; }
    100% { transform: scale(1) translateY(0); opacity: 1; }
  }

  ::view-transition-old(root) {
    animation: genie-out 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  ::view-transition-new(root) {
    animation: genie-in 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>
