---
// src/components/games/PlaneSim.astro
---

<div class="game-stage" id="planesim-container" style="position:relative; width:100%; height:500px; background:#000; overflow:hidden; border-radius:8px;">
  
  <div id="planesim-overlay" style="position:absolute; inset:0; background:rgba(11, 17, 24, 0.9); color:#fff; display:grid; place-items:center; z-index:10; backdrop-filter:blur(4px);">
    <div style="text-align:center;">
      <h3 style="margin-bottom:10px; font-family:var(--font-display); font-size:24px; color:var(--blue);">P-51 Mustang Dogfight</h3>
      <p style="font-size:13px; color:var(--ink-dim); margin-bottom:24px; max-width:400px; line-height:1.5;">
        Authentic P-51 model (Yellow Nose / Silver Body). Infinite procedural terrain. Press SPACE to fire machine guns at enemy drones.
      </p>
      <button id="planesim-start" class="btn primary">INITIALIZE ENGINE</button>
      
      <div style="margin-top:28px; font-size:12px; text-align:left; background:rgba(255,255,255,0.05); padding:16px; border-radius:6px; border:1px solid var(--line); display:inline-block;">
        <b style="color:var(--orange);">FLIGHT CONTROLS</b><br/><br/>
        <table style="color:#cbd5e1; border-spacing:8px 4px;">
          <tr><td><b>W / S</b></td><td>: Pitch Down / Up</td></tr>
          <tr><td><b>A / D</b></td><td>: Roll Left / Right</td></tr>
          <tr><td><b>SHIFT / CTRL</b></td><td>: Throttle Up / Down</td></tr>
          <tr><td><b>SPACE</b></td><td>: Fire Machine Guns</td></tr>
          <tr><td><b>C / F</b></td><td>: Camera / Fullscreen</td></tr>
        </table>
      </div>
    </div>
  </div>

  <!-- HUD -->
  <div id="planesim-hud" style="display:none; position:absolute; inset:0; pointer-events:none; z-index:5;">
    
    <!-- Fighter Reticle -->
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:50px; height:50px;">
      <div style="position:absolute; top:50%; left:0; width:15px; height:2px; background:rgba(0,255,100,0.8); transform:translateY(-50%);"></div>
      <div style="position:absolute; top:50%; right:0; width:15px; height:2px; background:rgba(0,255,100,0.8); transform:translateY(-50%);"></div>
      <div style="position:absolute; top:0; left:50%; width:2px; height:15px; background:rgba(0,255,100,0.8); transform:translateX(-50%);"></div>
      <div style="position:absolute; bottom:0; left:50%; width:2px; height:5px; background:rgba(0,255,100,0.8); transform:translateX(-50%);"></div>
      <div style="position:absolute; top:50%; left:50%; width:4px; height:4px; background:rgba(0,255,100,1); border-radius:50%; transform:translate(-50%,-50%);"></div>
      <!-- Gun Sight Circle -->
      <div style="position:absolute; top:50%; left:50%; width:30px; height:30px; border:1px solid rgba(0,255,100,0.4); border-radius:50%; transform:translate(-50%,-50%);"></div>
    </div>

    <!-- Tapes -->
    <div style="position:absolute; left:20px; top:50%; transform:translateY(-50%); width:60px; height:200px; border-left:2px solid rgba(0,255,100,0.5);">
      <div style="position:absolute; top:-25px; left:0; font-family:monospace; color:#0f6; font-size:12px; font-weight:bold;">SPD</div>
      <div style="position:absolute; top:50%; left:0; width:10px; height:2px; background:#0f6; transform:translateY(-50%);"></div>
      <div id="hud-speed" style="position:absolute; top:50%; left:16px; transform:translateY(-50%); font-family:monospace; color:#0f6; font-size:18px; font-weight:bold; text-shadow:1px 1px 2px #000;">000</div>
    </div>

    <div style="position:absolute; right:20px; top:50%; transform:translateY(-50%); width:60px; height:200px; border-right:2px solid rgba(0,255,100,0.5);">
      <div style="position:absolute; top:-25px; right:0; font-family:monospace; color:#0f6; font-size:12px; font-weight:bold; text-align:right;">ALT</div>
      <div style="position:absolute; top:50%; right:0; width:10px; height:2px; background:#0f6; transform:translateY(-50%);"></div>
      <div id="hud-alt" style="position:absolute; top:50%; right:16px; transform:translateY(-50%); font-family:monospace; color:#0f6; font-size:18px; font-weight:bold; text-align:right; text-shadow:1px 1px 2px #000;">0000</div>
    </div>

    <!-- Bottom Data -->
    <div style="position:absolute; bottom:20px; left:50%; transform:translateX(-50%); display:flex; gap:40px; font-family:monospace; color:#0f6; font-size:14px; text-shadow:1px 1px 2px #000; font-weight:bold;">
      <div>THR: <span id="hud-thrust">0</span>%</div>
      <div>HDG: <span id="hud-hdg">000</span>°</div>
      <div style="color:var(--orange);">KILLS: <span id="hud-kills">0</span></div>
    </div>

    <!-- Crash Banner -->
    <div id="hud-crash" style="display:none; position:absolute; top:35%; left:50%; transform:translate(-50%,-50%); text-align:center;">
      <h1 style="color:#ff3333; font-family:var(--font-display); font-size:48px; margin:0; text-shadow:2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000;">CRASHED</h1>
      <p style="color:#fff; font-family:monospace; font-size:16px; margin-top:10px; background:rgba(0,0,0,0.5); padding:4px 12px; border-radius:4px;">Press R to Restart</p>
    </div>
  </div>

  <canvas id="planesim-canvas" style="width:100%; height:100%; display:block; outline:none;"></canvas>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" is:inline></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Pre-initialize the engine immediately on load
    setTimeout(initSim, 100);

    function initSim() {
      const overlay = document.getElementById('planesim-overlay');
      if(overlay) overlay.style.display = 'none';
      const hud = document.getElementById('planesim-hud');
      if(hud) hud.style.display = 'block';

      const container = document.getElementById('planesim-container');
      const canvas = document.getElementById('planesim-canvas');
      
      const width = container.clientWidth || 800;
      const height = container.clientHeight || 500;

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false });
      renderer.setSize(width, height);
      // Disable shadows for massive performance boost needed for infinite terrain & dogfighting
      renderer.shadowMap.enabled = false;
      
      const skyColor = new THREE.Color(0x76b6e4);
      const scene = new THREE.Scene();
      scene.background = skyColor;
      scene.fog = new THREE.FogExp2(skyColor, 0.00015);

      const camera = new THREE.PerspectiveCamera(60, width / height, 1, 40000);
      let cameraMode = 'chase';

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xfffaed, 1.2);
      dirLight.position.set(2000, 4000, 2000);
      scene.add(dirLight);

      // --- HIGH QUALITY P-51 MUSTANG (YELLOW NOSE) ---
      const plane = new THREE.Group();
      
      const metalMat = new THREE.MeshStandardMaterial({ color: 0xcccccc, roughness: 0.2, metalness: 0.9 });
      const yellowMat = new THREE.MeshStandardMaterial({ color: 0xfacc15, roughness: 0.4 });
      const oliveMat = new THREE.MeshStandardMaterial({ color: 0x4a5320, roughness: 0.8 });
      const blackMat = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.8 });
      const whiteMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.8 });
      const glassMat = new THREE.MeshStandardMaterial({ color: 0x223344, roughness: 0.1, metalness: 0.9, transparent: true, opacity: 0.5 });

      // High-Poly Fuselage
      const points = [];
      for ( let i = 0; i <= 32; i ++ ) {
        const t = i / 32;
        const x = t * 14 - 7;
        const r = Math.sin(t * Math.PI) * 1.3 + (t < 0.2 ? 0.05 : 0.2); 
        points.push( new THREE.Vector2( r, x ) );
      }
      const latheGeo = new THREE.LatheGeometry( points, 64 );
      latheGeo.rotateX(Math.PI / 2);
      const fuselage = new THREE.Mesh( latheGeo, metalMat );
      plane.add(fuselage);

      // Yellow Nose Cowl (Fits over the front of fuselage)
      const cowlGeo = new THREE.CylinderGeometry(0.5, 1.3, 3, 64);
      cowlGeo.rotateX(Math.PI / 2);
      const cowl = new THREE.Mesh(cowlGeo, yellowMat);
      cowl.position.z = 5.5;
      plane.add(cowl);

      // Yellow Spinner
      const spinnerGeo = new THREE.ConeGeometry(0.5, 1.2, 64);
      spinnerGeo.rotateX(Math.PI/2);
      const spinner = new THREE.Mesh(spinnerGeo, yellowMat);
      spinner.position.z = 7.5;
      plane.add(spinner);

      // Olive Drab Anti-Glare Strip
      const stripGeo = new THREE.CylinderGeometry(1.31, 1.45, 3.2, 32, 1, false, Math.PI * 0.35, Math.PI * 0.3);
      stripGeo.rotateX(Math.PI / 2);
      const strip = new THREE.Mesh(stripGeo, oliveMat);
      strip.position.z = 4.5;
      strip.position.y = -0.05;
      plane.add(strip);

      // Belly Radiator Scoop
      const scoopShape = new THREE.Shape();
      scoopShape.moveTo(0, 0); scoopShape.lineTo(0.7, 0); scoopShape.lineTo(1.0, -1.0);
      scoopShape.lineTo(-1.0, -1.0); scoopShape.lineTo(-0.7, 0); scoopShape.lineTo(0, 0);
      const scoopGeo = new THREE.ExtrudeGeometry(scoopShape, { depth: 4, bevelEnabled: true, bevelSegments: 4, steps: 2, bevelSize: 0.1, bevelThickness: 0.1 });
      const scoop = new THREE.Mesh(scoopGeo, metalMat);
      scoop.position.set(0, -0.8, -4);
      plane.add(scoop);

      // High-Poly Bubble Canopy
      const canopyGeo = new THREE.SphereGeometry(1.0, 64, 32, 0, Math.PI * 2, 0, Math.PI / 2);
      const canopy = new THREE.Mesh(canopyGeo, glassMat);
      canopy.scale.set(0.7, 1, 2.5);
      canopy.position.set(0, 0.9, -0.2);
      plane.add(canopy);

      // Wings with Invasion Stripes
      const wingShape = new THREE.Shape();
      wingShape.moveTo(0, 0); wingShape.lineTo(18, -1.5); wingShape.lineTo(18, -3.5); wingShape.lineTo(0, -3.5);
      const wingGeo = new THREE.ExtrudeGeometry(wingShape, { depth: 0.15, bevelEnabled: true, bevelSize: 0.05, bevelThickness: 0.05 });
      wingGeo.rotateX(Math.PI / 2);
      const wingMesh = new THREE.Mesh(wingGeo, metalMat);
      wingMesh.position.set(-9, -0.2, 1.5); 
      plane.add(wingMesh);

      // Stripes overlay
      const stripeGeo = new THREE.PlaneGeometry(1.5, 3.5);
      stripeGeo.rotateX(-Math.PI / 2);
      const wStripe1 = new THREE.Mesh(stripeGeo, whiteMat); wStripe1.position.set(4, -0.18, 0.2); plane.add(wStripe1);
      const bStripe1 = new THREE.Mesh(stripeGeo, blackMat); bStripe1.position.set(5.5, -0.18, 0.1); plane.add(bStripe1);
      const wStripe2 = new THREE.Mesh(stripeGeo, whiteMat); wStripe2.position.set(7, -0.18, 0); plane.add(wStripe2);
      const wStripe3 = new THREE.Mesh(stripeGeo, whiteMat); wStripe3.position.set(-4, -0.18, 0.2); plane.add(wStripe3);
      const bStripe2 = new THREE.Mesh(stripeGeo, blackMat); bStripe2.position.set(-5.5, -0.18, 0.1); plane.add(bStripe2);
      const wStripe3b = new THREE.Mesh(stripeGeo, whiteMat); wStripe3b.position.set(-7, -0.18, 0); plane.add(wStripe3b);

      // PROPORTIONATE Tail (Vertical)
      const vStabShape = new THREE.Shape();
      vStabShape.moveTo(0, 0); vStabShape.lineTo(0, 2.2); vStabShape.lineTo(1.8, 2.2); vStabShape.lineTo(3.5, 0);
      const vStabGeo = new THREE.ExtrudeGeometry(vStabShape, { depth: 0.1, bevelEnabled: true, bevelSize: 0.02, bevelThickness: 0.02 });
      const vStab = new THREE.Mesh(vStabGeo, metalMat);
      vStab.position.set(-0.05, 0.2, -6.5);
      plane.add(vStab);

      // PROPORTIONATE Tail (Horizontal)
      const hStabGeo = new THREE.BoxGeometry(5.5, 0.1, 1.8);
      const hStab = new THREE.Mesh(hStabGeo, metalMat);
      hStab.position.set(0, 0.3, -5.5);
      plane.add(hStab);

      // Propeller Blades (Motion blur effect)
      const propGroup = new THREE.Group();
      propGroup.position.z = 7.4;
      const bladeGeo = new THREE.BoxGeometry(0.1, 5, 0.2);
      for(let i=0; i<4; i++) {
        const blade = new THREE.Mesh(bladeGeo, blackMat);
        blade.rotation.z = (Math.PI / 2) * i;
        blade.rotation.x = 0.2;
        propGroup.add(blade);
      }
      // Transparent disc for speed blur
      const blurGeo = new THREE.CylinderGeometry(2.5, 2.5, 0.05, 32);
      blurGeo.rotateX(Math.PI/2);
      const blurMat = new THREE.MeshBasicMaterial({ color: 0x111111, transparent: true, opacity: 0.15 });
      const blurDisc = new THREE.Mesh(blurGeo, blurMat);
      propGroup.add(blurDisc);
      plane.add(propGroup);

      scene.add(plane);


      // --- INFINITE MINECRAFT-STYLE TERRAIN CHUNKS ---
      const CHUNK_SIZE = 12000;
      const CHUNK_RES = 64;
      const chunks = {}; // Map of "x,z" to Mesh
      const waterChunks = {};

      const terrainMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.9, flatShading: true });
      const waterMat = new THREE.MeshStandardMaterial({ color: 0x1f5c87, transparent: true, opacity: 0.8, roughness: 0.1 });

      function random(x, z) { return Math.sin(x * 12.9898 + z * 78.233) * 43758.5453 % 1; }
      function noise(x, z) {
        const ix = Math.floor(x), iz = Math.floor(z);
        const fx = x - ix, fz = z - iz;
        const a = random(ix, iz), b = random(ix + 1, iz), c = random(ix, iz + 1), d = random(ix + 1, iz + 1);
        const ux = fx * fx * (3 - 2 * fx), uz = fz * fz * (3 - 2 * fz);
        return a + (b - a) * ux + (c - a) * uz + (a - b - c + d) * ux * uz;
      }
      function fbm(x, z) {
        let val = 0; let amp = 1; let freq = 1;
        for(let i=0; i<4; i++) { val += noise(x * freq, z * freq) * amp; amp *= 0.5; freq *= 2; }
        return val;
      }

      function getTerrainHeight(x, z) {
        let h = fbm(x * 0.0001, z * 0.0001) * 2500 - 500;
        const river1 = Math.abs(Math.sin(x * 0.0002 + Math.cos(z * 0.0003))) * 500;
        const river2 = Math.abs(Math.cos(z * 0.00015 + Math.sin(x * 0.00025))) * 500;
        h -= (1000 / (river1 + 50));
        h -= (1000 / (river2 + 50));
        return Math.max(h, -20); // allow slight depth for water
      }

      function createChunk(cx, cz) {
        const geo = new THREE.PlaneGeometry(CHUNK_SIZE, CHUNK_SIZE, CHUNK_RES, CHUNK_RES);
        geo.rotateX(-Math.PI / 2);
        
        const tPos = geo.attributes.position;
        const colors = [];
        const colorObj = new THREE.Color();
        
        const offsetX = cx * CHUNK_SIZE;
        const offsetZ = cz * CHUNK_SIZE;

        for(let i = 0; i < tPos.count; i++) {
          const worldX = tPos.getX(i) + offsetX;
          const worldZ = tPos.getZ(i) + offsetZ;
          
          let h = getTerrainHeight(worldX, worldZ);
          tPos.setY(i, h);

          if(h < 0) colorObj.setHex(0xc2b280); 
          else if (h > 1200) colorObj.setHex(0xeef2f5); 
          else if (h > 600) colorObj.setHex(0x546351); 
          else colorObj.setHex(0x456a33); 
          colors.push(colorObj.r, colorObj.g, colorObj.b);
        }
        
        geo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
        geo.computeVertexNormals();
        
        const mesh = new THREE.Mesh(geo, terrainMat);
        mesh.position.set(offsetX, 0, offsetZ);
        scene.add(mesh);
        
        const waterGeo = new THREE.PlaneGeometry(CHUNK_SIZE, CHUNK_SIZE);
        waterGeo.rotateX(-Math.PI / 2);
        const water = new THREE.Mesh(waterGeo, waterMat);
        water.position.set(offsetX, 0, offsetZ);
        scene.add(water);

        return { terrain: mesh, water: water };
      }

      let lastChunkX = null;
      let lastChunkZ = null;

      function updateTerrain(planeX, planeZ) {
        const cx = Math.round(planeX / CHUNK_SIZE);
        const cz = Math.round(planeZ / CHUNK_SIZE);
        if (cx === lastChunkX && cz === lastChunkZ) return;
        lastChunkX = cx; lastChunkZ = cz;

        const needed = new Set();
        for(let dx = -1; dx <= 1; dx++) {
          for(let dz = -1; dz <= 1; dz++) {
            needed.add(`${cx+dx},${cz+dz}`);
            if(!chunks[`${cx+dx},${cz+dz}`]) {
              chunks[`${cx+dx},${cz+dz}`] = createChunk(cx+dx, cz+dz);
            }
          }
        }
        
        // Remove chunks too far away
        for(let key in chunks) {
          if(!needed.has(key)) {
            scene.remove(chunks[key].terrain);
            scene.remove(chunks[key].water);
            chunks[key].terrain.geometry.dispose();
            chunks[key].water.geometry.dispose();
            delete chunks[key];
          }
        }
      }

      // --- GUNS & TRACERS ---
      const bullets = [];
      const bulletGeo = new THREE.CylinderGeometry(0.1, 0.1, 10, 8);
      bulletGeo.rotateX(Math.PI/2);
      const bulletMat = new THREE.MeshBasicMaterial({ color: 0xffaa00 });

      let lastFireTime = 0;
      function fireGun(forward) {
        const now = performance.now();
        if (now - lastFireTime < 100) return; // Fire rate: 10 rounds/sec
        lastFireTime = now;

        const bullet = new THREE.Mesh(bulletGeo, bulletMat);
        // Spawn from wing guns
        const offset = new THREE.Vector3(Math.random() > 0.5 ? 2 : -2, 0, 1.5).applyQuaternion(plane.quaternion);
        bullet.position.copy(plane.position).add(offset);
        bullet.quaternion.copy(plane.quaternion);
        
        // Bullet travels at 800 m/s relative to plane
        const vel = forward.clone().multiplyScalar(800).add(state.vel);
        
        scene.add(bullet);
        bullets.push({ mesh: bullet, vel: vel, life: 2.0 });
      }

      // --- ENEMY DRONES ---
      const drones = [];
      const droneGeo = new THREE.BoxGeometry(4, 1, 4);
      const droneMat = new THREE.MeshStandardMaterial({ color: 0xcc0000 });
      
      let kills = 0;
      const killCounter = document.getElementById('hud-kills');

      function spawnDrone() {
        const drone = new THREE.Mesh(droneGeo, droneMat);
        // Spawn 3000m away
        const angle = Math.random() * Math.PI * 2;
        drone.position.set(
          state.pos.x + Math.cos(angle) * 3000,
          Math.random() * 1500 + 500,
          state.pos.z + Math.sin(angle) * 3000
        );
        scene.add(drone);
        drones.push({ mesh: drone, hp: 1 });
      }
      
      // Spawn initial 5 drones
      for(let i=0; i<5; i++) spawnDrone();

      // --- PHYSICS ENGINE ---
      const state = {
        pos: new THREE.Vector3(0, 1000, 0),
        vel: new THREE.Vector3(0, 0, 150),
        quaternion: new THREE.Quaternion(),
        throttle: 0.5,
        pitchInput: 0,
        rollInput: 0,
        crashed: false
      };

      plane.position.copy(state.pos);

      const GRAVITY = 9.81;
      const MASS = 3500;
      const MAX_THRUST = 70000;
      const WING_AREA = 22;
      const AIR_DENSITY = 1.225;
      
      const keys = {};
      window.addEventListener('keydown', e => {
        if(state.crashed && e.key.toLowerCase() === 'r') { resetSim(); return; }
        if(e.key.toLowerCase() === 'f') { toggleFullscreen(); return; }
        keys[e.key.toLowerCase()] = true;
        if(e.key === ' ') keys['space'] = true;
        if(e.key.toLowerCase() === 'c') cameraMode = cameraMode === 'chase' ? 'cockpit' : 'chase';
      });
      window.addEventListener('keyup', e => {
        keys[e.key.toLowerCase()] = false;
        if(e.key === ' ') keys['space'] = false;
      });

      function toggleFullscreen() {
        if (!document.fullscreenElement) container.requestFullscreen().catch(()=>{});
        else document.exitFullscreen();
      }

      function resetSim() {
        state.crashed = false;
        state.pos.set(0, 1000, 0);
        state.vel.set(0, 0, 150);
        state.quaternion.identity();
        state.throttle = 0.5;
        lastChunkX = null; // force chunk update
        document.getElementById('hud-crash').style.display = 'none';
      }

      const clock = new THREE.Clock();

      function updatePhysics(dt) {
        if(state.crashed) return;

        if(keys['shift']) state.throttle = Math.min(1, state.throttle + 0.5 * dt);
        if(keys['control']) state.throttle = Math.max(0, state.throttle - 0.5 * dt);
        
        let targetPitch = 0;
        if(keys['w']) targetPitch = 1;   // W = Pitch Down (Nose down)
        if(keys['s']) targetPitch = -1;  // S = Pitch Up (Nose up)
        
        let targetRoll = 0;
        if(keys['a']) targetRoll = -1;   // A = Roll Left
        if(keys['d']) targetRoll = 1;    // D = Roll Right

        state.pitchInput = THREE.MathUtils.lerp(state.pitchInput, targetPitch, dt * 5);
        state.rollInput = THREE.MathUtils.lerp(state.rollInput, targetRoll, dt * 5);

        const rollQuat = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0,0,1), state.rollInput * 3.0 * dt);
        const pitchQuat = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1,0,0), state.pitchInput * 2.0 * dt);
        
        state.quaternion.multiply(rollQuat);
        state.quaternion.multiply(pitchQuat);
        
        const euler = new THREE.Euler().setFromQuaternion(state.quaternion, 'YXZ');
        euler.y -= euler.z * 1.0 * dt; 
        state.quaternion.setFromEuler(euler);
        plane.quaternion.copy(state.quaternion);

        const forward = new THREE.Vector3(0,0,1).applyQuaternion(state.quaternion);
        const up = new THREE.Vector3(0,1,0).applyQuaternion(state.quaternion);
        
        const speedSq = state.vel.lengthSq();
        const speed = Math.sqrt(speedSq);

        const thrustForce = forward.clone().multiplyScalar(state.throttle * MAX_THRUST);
        const dragForce = state.vel.clone().normalize().multiplyScalar(-0.5 * AIR_DENSITY * speedSq * 0.08);

        const velDir = speed > 0 ? state.vel.clone().normalize() : forward.clone();
        const aoa = forward.dot(velDir);
        const liftForce = up.clone().multiplyScalar(0.5 * AIR_DENSITY * speedSq * WING_AREA * 0.08 * Math.max(0.1, aoa));

        const gravityForce = new THREE.Vector3(0, -MASS * GRAVITY, 0);
        const totalForce = new THREE.Vector3().add(thrustForce).add(dragForce).add(liftForce).add(gravityForce);

        const accel = totalForce.divideScalar(MASS);
        state.vel.add(accel.multiplyScalar(dt));
        state.pos.add(state.vel.clone().multiplyScalar(dt));

        // Crash Detection (Use Math.max(0) because water is at 0)
        const groundY = Math.max(getTerrainHeight(state.pos.x, state.pos.z), 0);
        if(state.pos.y < groundY + 2) { 
          state.crashed = true;
          document.getElementById('hud-crash').style.display = 'block';
          state.pos.y = groundY;
          state.vel.set(0,0,0);
        }

        plane.position.copy(state.pos);
        updateTerrain(state.pos.x, state.pos.z);
        
        propGroup.rotation.z += (state.throttle * 30 + 5) * dt;
        blurDisc.material.opacity = state.throttle * 0.4;

        if (keys['space']) fireGun(forward);

        // Update Bullets & Drones
        for(let i=bullets.length-1; i>=0; i--) {
          const b = bullets[i];
          b.mesh.position.add(b.vel.clone().multiplyScalar(dt));
          b.life -= dt;
          
          // Collision check against drones
          let hit = false;
          for(let d=0; d<drones.length; d++) {
            if (b.mesh.position.distanceTo(drones[d].mesh.position) < 15) {
              scene.remove(drones[d].mesh);
              drones.splice(d, 1);
              hit = true;
              kills++;
              killCounter.innerText = kills;
              spawnDrone(); // Replace drone
              break;
            }
          }

          if(b.life <= 0 || hit) {
            scene.remove(b.mesh);
            bullets.splice(i, 1);
          }
        }

        // Drone AI (fly towards player slowly)
        drones.forEach(d => {
          const dir = state.pos.clone().sub(d.mesh.position).normalize();
          d.mesh.position.add(dir.multiplyScalar(100 * dt)); // 100 m/s
          d.mesh.lookAt(state.pos);
        });

        // HUD
        document.getElementById('hud-thrust').innerText = Math.round(state.throttle * 100);
        document.getElementById('hud-speed').innerText = Math.round(speed * 1.94384);
        document.getElementById('hud-alt').innerText = Math.round(state.pos.y * 3.28084);
        let hdg = Math.round(THREE.MathUtils.radToDeg(Math.atan2(forward.x, forward.z)));
        if (hdg < 0) hdg += 360;
        document.getElementById('hud-hdg').innerText = hdg.toString().padStart(3, '0');
      }

      function updateCamera() {
        if(cameraMode === 'chase') {
          const offset = new THREE.Vector3(0, 10, -35).applyQuaternion(plane.quaternion);
          const targetPos = plane.position.clone().add(offset);
          camera.position.lerp(targetPos, 0.15);
          camera.lookAt(plane.position.clone().add(new THREE.Vector3(0,0,50).applyQuaternion(plane.quaternion)));
        } else {
          const offset = new THREE.Vector3(0, 1.3, 0).applyQuaternion(plane.quaternion);
          camera.position.copy(plane.position).add(offset);
          camera.lookAt(plane.position.clone().add(new THREE.Vector3(0,0.5,50).applyQuaternion(plane.quaternion)));
        }
      }

      window.addEventListener('resize', () => {
        const w = container.clientWidth;
        const h = container.clientHeight;
        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      });

      const clock = new THREE.Clock();
      function animate() {
        requestAnimationFrame(animate);
        
        // Pause physics and rendering if the game stage is not visible (e.g. another tab is active)
        if (container.offsetParent === null) {
          clock.getDelta(); // keep clock ticking so dt doesn't jump
          return;
        }

        const dt = Math.min(clock.getDelta(), 0.1);
        
        updatePhysics(dt);
        updateCamera();
        
        // Keep light near plane for consistent lighting in infinite world
        dirLight.position.set(state.pos.x + 1000, 4000, state.pos.z + 1000);
        
        renderer.render(scene, camera);
      }

      animate();
    }
  });
</script>
