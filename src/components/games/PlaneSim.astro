---
// src/components/games/PlaneSim.astro
---

<div class="game-stage" id="planesim-container" style="position:relative; width:100%; height:500px; background:#000; overflow:hidden; border-radius:8px;">
  <!-- Loading screen before Three.js starts -->
  <div id="planesim-overlay" style="position:absolute; inset:0; background:rgba(0,0,0,0.8); color:#fff; display:grid; place-items:center; z-index:10;">
    <div style="text-align:center;">
      <h3 style="margin-bottom:10px; font-family:var(--font-display);">3D Flight Simulator</h3>
      <p style="font-size:12px; color:var(--ink-dim); margin-bottom:20px;">Realistic Aerodynamics & Volumetric Clouds</p>
      <button id="planesim-start" class="btn primary">INITIALIZE ENGINE</button>
      <div style="margin-top:20px; font-size:11px; text-align:left; background:rgba(255,255,255,0.1); padding:10px; border-radius:4px;">
        <b>Controls:</b><br/>
        W / S : Pitch Down / Up<br/>
        A / D : Roll Left / Right<br/>
        SHIFT / CTRL : Throttle Up / Down<br/>
        C : Toggle Camera (Chase / Cockpit)
      </div>
    </div>
  </div>

  <!-- HUD -->
  <div id="planesim-hud" style="display:none; position:absolute; inset:0; pointer-events:none; z-index:5;">
    <div style="position:absolute; top:20px; left:20px; color:#0f0; font-family:monospace; font-size:14px; text-shadow:1px 1px 2px #000;">
      THRUST: <span id="hud-thrust">0</span>%<br/>
      SPEED: <span id="hud-speed">0</span> kts<br/>
      ALTITUDE: <span id="hud-alt">0</span> ft
    </div>
    <!-- Crosshair for cockpit view -->
    <div id="hud-crosshair" style="display:none; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); color:rgba(0,255,0,0.5); font-size:24px;">+</div>
  </div>

  <canvas id="planesim-canvas" style="width:100%; height:100%; display:block;"></canvas>
</div>

<!-- Load Three.js from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" is:inline></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const startBtn = document.getElementById('planesim-start');
    if (!startBtn) return;

    startBtn.addEventListener('click', initSim);

    function initSim() {
      document.getElementById('planesim-overlay').style.display = 'none';
      document.getElementById('planesim-hud').style.display = 'block';

      // Ensure THREE is loaded
      if (typeof THREE === 'undefined') {
        alert('Failed to load 3D engine. Please check your internet connection.');
        return;
      }

      const canvas = document.getElementById('planesim-canvas');
      const container = document.getElementById('planesim-container');
      
      const width = container.clientWidth;
      const height = container.clientHeight;

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setSize(width, height);
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x5a9bd4);
      scene.fog = new THREE.FogExp2(0x5a9bd4, 0.0015);

      // Camera
      const camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 5000);
      let cameraMode = 'chase'; // 'chase' or 'cockpit'

      // Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xfffaed, 1.2);
      dirLight.position.set(500, 1000, 500);
      dirLight.castShadow = true;
      dirLight.shadow.camera.left = -500;
      dirLight.shadow.camera.right = 500;
      dirLight.shadow.camera.top = 500;
      dirLight.shadow.camera.bottom = -500;
      dirLight.shadow.camera.far = 3000;
      dirLight.shadow.mapSize.width = 2048;
      dirLight.shadow.mapSize.height = 2048;
      scene.add(dirLight);

      // --- PROCEDURAL HIGH-POLY PLANE MODEL ---
      const plane = new THREE.Group();
      
      const fuselageMat = new THREE.MeshStandardMaterial({ color: 0xdddddd, roughness: 0.4, metalness: 0.6 });
      const wingMat = new THREE.MeshStandardMaterial({ color: 0xcc0000, roughness: 0.5 });
      const glassMat = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.1, metalness: 0.9, transparent: true, opacity: 0.8 });
      const darkMat = new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.8 });

      // Fuselage (Cylinder rounded)
      const fuselageGeo = new THREE.CylinderGeometry(0.8, 1.2, 10, 32);
      fuselageGeo.rotateX(Math.PI / 2);
      const fuselage = new THREE.Mesh(fuselageGeo, fuselageMat);
      fuselage.castShadow = true;
      fuselage.receiveShadow = true;
      plane.add(fuselage);
      
      // Nose cone
      const noseGeo = new THREE.SphereGeometry(0.8, 32, 16);
      const nose = new THREE.Mesh(noseGeo, fuselageMat);
      nose.position.z = 5;
      nose.scale.set(1, 1, 1.5);
      plane.add(nose);

      // Tail cone
      const tailGeo = new THREE.CylinderGeometry(0.2, 1.2, 4, 32);
      tailGeo.rotateX(Math.PI / 2);
      const tail = new THREE.Mesh(tailGeo, fuselageMat);
      tail.position.z = -7;
      plane.add(tail);

      // Wings
      const wingGeo = new THREE.BoxGeometry(16, 0.2, 2.5);
      const wings = new THREE.Mesh(wingGeo, wingMat);
      wings.position.set(0, 0, 1.5);
      wings.castShadow = true;
      plane.add(wings);

      // Vertical Stabilizer
      const vStabGeo = new THREE.BoxGeometry(0.2, 3, 2);
      const vStab = new THREE.Mesh(vStabGeo, wingMat);
      vStab.position.set(0, 1.5, -8);
      // Swept back
      const vStabVerts = vStabGeo.attributes.position;
      for(let i=0; i<vStabVerts.count; i++) {
        if(vStabVerts.getY(i) > 0) vStabVerts.setZ(i, vStabVerts.getZ(i) - 1.5);
      }
      vStabGeo.computeVertexNormals();
      plane.add(vStab);

      // Horizontal Stabilizer
      const hStabGeo = new THREE.BoxGeometry(5, 0.1, 1.5);
      const hStab = new THREE.Mesh(hStabGeo, wingMat);
      hStab.position.set(0, 0, -8);
      plane.add(hStab);

      // Cockpit
      const cockpitGeo = new THREE.BoxGeometry(1.2, 1, 3);
      const cockpit = new THREE.Mesh(cockpitGeo, glassMat);
      cockpit.position.set(0, 1, 2);
      plane.add(cockpit);

      // Propeller
      const propGroup = new THREE.Group();
      propGroup.position.z = 6.2;
      const propHubGeo = new THREE.CylinderGeometry(0.3, 0.3, 0.5, 16);
      propHubGeo.rotateX(Math.PI/2);
      const propHub = new THREE.Mesh(propHubGeo, darkMat);
      propGroup.add(propHub);
      
      const bladeGeo = new THREE.BoxGeometry(0.1, 4, 0.2);
      const blade1 = new THREE.Mesh(bladeGeo, darkMat);
      const blade2 = new THREE.Mesh(bladeGeo, darkMat);
      blade2.rotation.z = Math.PI / 2;
      propGroup.add(blade1);
      propGroup.add(blade2);
      
      plane.add(propGroup);
      scene.add(plane);

      // --- VOLUMETRIC CLOUDS ---
      // We generate a procedural noise texture for cloud sprites on a canvas
      const cloudCanvas = document.createElement('canvas');
      cloudCanvas.width = 128;
      cloudCanvas.height = 128;
      const cctx = cloudCanvas.getContext('2d');
      const grad = cctx.createRadialGradient(64,64,0, 64,64,64);
      grad.addColorStop(0, 'rgba(255,255,255,1)');
      grad.addColorStop(0.4, 'rgba(255,255,255,0.8)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      cctx.fillStyle = grad;
      cctx.fillRect(0,0, 128,128);
      
      const cloudTex = new THREE.CanvasTexture(cloudCanvas);
      const cloudMat = new THREE.SpriteMaterial({
        map: cloudTex,
        color: 0xffffff,
        transparent: true,
        opacity: 0.6,
        depthWrite: false,
        blending: THREE.NormalBlending
      });

      const cloudGroup = new THREE.Group();
      for(let i=0; i<300; i++) {
        const sprite = new THREE.Sprite(cloudMat);
        const size = Math.random() * 200 + 100;
        sprite.scale.set(size, size, 1);
        sprite.position.set(
          (Math.random() - 0.5) * 4000,
          Math.random() * 400 + 300, // Clouds between 300 and 700 altitude
          (Math.random() - 0.5) * 4000
        );
        cloudGroup.add(sprite);
      }
      scene.add(cloudGroup);

      // --- PROCEDURAL TERRAIN ---
      const terrainGeo = new THREE.PlaneGeometry(10000, 10000, 100, 100);
      terrainGeo.rotateX(-Math.PI / 2);
      const verts = terrainGeo.attributes.position;
      for(let i=0; i<verts.count; i++) {
        const x = verts.getX(i);
        const z = verts.getZ(i);
        // Simple procedural hills using sine waves
        const y = Math.sin(x * 0.001) * Math.cos(z * 0.001) * 150 + 
                  Math.sin(x * 0.005 + z * 0.002) * 20;
        verts.setY(i, y);
      }
      terrainGeo.computeVertexNormals();
      const terrainMat = new THREE.MeshStandardMaterial({ 
        color: 0x3d733a, 
        roughness: 0.9, 
        flatShading: true // Low poly look
      });
      const terrain = new THREE.Mesh(terrainGeo, terrainMat);
      terrain.receiveShadow = true;
      terrain.position.y = -50;
      scene.add(terrain);

      // --- PHYSICS ENGINE ---
      const state = {
        pos: new THREE.Vector3(0, 400, 0),
        vel: new THREE.Vector3(0, 0, 50), // Initial forward speed
        quaternion: new THREE.Quaternion(),
        throttle: 0,
        pitchInput: 0,
        rollInput: 0
      };

      plane.position.copy(state.pos);

      // Constants
      const GRAVITY = 9.81;
      const MASS = 1000;
      const MAX_THRUST = 20000;
      const WING_AREA = 20;
      const AIR_DENSITY = 1.225;
      
      // Controls
      const keys = {};
      window.addEventListener('keydown', e => {
        keys[e.key.toLowerCase()] = true;
        if(e.key.toLowerCase() === 'c') {
          cameraMode = cameraMode === 'chase' ? 'cockpit' : 'chase';
          document.getElementById('hud-crosshair').style.display = cameraMode === 'cockpit' ? 'block' : 'none';
        }
      });
      window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

      const clock = new THREE.Clock();

      const hudThrust = document.getElementById('hud-thrust');
      const hudSpeed = document.getElementById('hud-speed');
      const hudAlt = document.getElementById('hud-alt');

      function updatePhysics(dt) {
        // Inputs
        if(keys['shift']) state.throttle = Math.min(1, state.throttle + 0.5 * dt);
        if(keys['control']) state.throttle = Math.max(0, state.throttle - 0.5 * dt);
        
        let targetPitch = 0;
        if(keys['w']) targetPitch = 1;
        if(keys['s']) targetPitch = -1;
        state.pitchInput = THREE.MathUtils.lerp(state.pitchInput, targetPitch, dt * 5);

        let targetRoll = 0;
        if(keys['a']) targetRoll = 1;
        if(keys['d']) targetRoll = -1;
        state.rollInput = THREE.MathUtils.lerp(state.rollInput, targetRoll, dt * 5);

        // Apply inputs to rotation
        // Roll around local Z
        const rollQuat = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0,0,1), state.rollInput * 2 * dt);
        // Pitch around local X
        const pitchQuat = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1,0,0), state.pitchInput * 1.5 * dt);
        
        state.quaternion.multiply(rollQuat);
        state.quaternion.multiply(pitchQuat);
        
        // Auto-level yaw gently based on roll (coordinated turn simplification)
        const euler = new THREE.Euler().setFromQuaternion(state.quaternion, 'YXZ');
        euler.y += euler.z * 0.5 * dt; 
        state.quaternion.setFromEuler(euler);

        plane.quaternion.copy(state.quaternion);

        // Physics calculations
        const forward = new THREE.Vector3(0,0,1).applyQuaternion(state.quaternion);
        const up = new THREE.Vector3(0,1,0).applyQuaternion(state.quaternion);
        
        const speedSq = state.vel.lengthSq();
        const speed = Math.sqrt(speedSq);

        // Thrust
        const thrustForce = forward.clone().multiplyScalar(state.throttle * MAX_THRUST);

        // Drag (proportional to v^2)
        const dragForce = state.vel.clone().normalize().multiplyScalar(-0.5 * AIR_DENSITY * speedSq * 0.5);

        // Lift (proportional to v^2, acting upwards relative to plane)
        // Simplified Angle of Attack: dot product of velocity direction and plane's up vector
        const velDir = speed > 0 ? state.vel.clone().normalize() : forward.clone();
        const aoa = forward.dot(velDir); // Simple approximation
        const liftForce = up.clone().multiplyScalar(0.5 * AIR_DENSITY * speedSq * WING_AREA * 0.1 * Math.max(0, aoa));

        // Gravity
        const gravityForce = new THREE.Vector3(0, -MASS * GRAVITY, 0);

        // Total force
        const totalForce = new THREE.Vector3()
          .add(thrustForce)
          .add(dragForce)
          .add(liftForce)
          .add(gravityForce);

        // Acceleration
        const accel = totalForce.divideScalar(MASS);
        
        // Update velocity
        state.vel.add(accel.multiplyScalar(dt));
        
        // Update position
        state.pos.add(state.vel.clone().multiplyScalar(dt));

        // Ground collision
        if(state.pos.y < -30) {
          state.pos.y = -30;
          state.vel.set(0,0,0); // Crash stop
        }

        plane.position.copy(state.pos);

        // Propeller animation
        propGroup.rotation.z += (state.throttle * 20 + 2) * dt;

        // Infinite clouds / terrain illusion
        // If plane moves too far, shift clouds
        cloudGroup.children.forEach(c => {
          if (c.position.distanceTo(state.pos) > 2500) {
            c.position.add(state.vel.clone().normalize().multiplyScalar(4000));
          }
          // Face camera (billboarding)
          c.quaternion.copy(camera.quaternion);
        });

        // HUD updates
        hudThrust.innerText = Math.round(state.throttle * 100);
        hudSpeed.innerText = Math.round(speed * 3.6); // roughly km/h to knots
        hudAlt.innerText = Math.round((state.pos.y + 50) * 3.28); // meters to feet
      }

      function updateCamera() {
        if(cameraMode === 'chase') {
          // Position camera behind and slightly above the plane
          const offset = new THREE.Vector3(0, 8, -25);
          offset.applyQuaternion(plane.quaternion);
          const targetPos = plane.position.clone().add(offset);
          camera.position.lerp(targetPos, 0.1);
          
          const lookTarget = plane.position.clone().add(new THREE.Vector3(0,0,10).applyQuaternion(plane.quaternion));
          camera.lookAt(lookTarget);
        } else {
          // Cockpit view
          const offset = new THREE.Vector3(0, 1.2, 1);
          offset.applyQuaternion(plane.quaternion);
          camera.position.copy(plane.position).add(offset);
          
          const lookTarget = plane.position.clone().add(new THREE.Vector3(0,1.2,20).applyQuaternion(plane.quaternion));
          camera.lookAt(lookTarget);
        }
      }

      // Handle window resize
      window.addEventListener('resize', () => {
        const w = container.clientWidth;
        const h = container.clientHeight;
        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      });

      function animate() {
        requestAnimationFrame(animate);
        const dt = Math.min(clock.getDelta(), 0.1); // Cap delta time
        
        updatePhysics(dt);
        updateCamera();
        
        renderer.render(scene, camera);
      }

      animate();
    }
  });
</script>
