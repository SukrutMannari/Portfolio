---
// src/components/games/PlaneSim.astro
---

<div class="game-stage" id="planesim-container" style="position:relative; width:100%; height:500px; background:#000; overflow:hidden; border-radius:8px;">
  
  <!-- Loading / Start Screen -->
  <div id="planesim-overlay" style="position:absolute; inset:0; background:rgba(11, 17, 24, 0.9); color:#fff; display:grid; place-items:center; z-index:10; backdrop-filter:blur(4px);">
    <div style="text-align:center;">
      <h3 style="margin-bottom:10px; font-family:var(--font-display); font-size:24px; color:var(--blue);">P-51 Mustang Flight Simulator</h3>
      <p style="font-size:13px; color:var(--ink-dim); margin-bottom:24px; max-width:400px; line-height:1.5;">
        Explore a procedurally generated 20km x 20km world with mountains, rivers, and towns. Realistic aerodynamics apply — watch your speed and angle of attack!
      </p>
      <button id="planesim-start" class="btn primary">INITIALIZE ENGINE</button>
      
      <div style="margin-top:28px; font-size:12px; text-align:left; background:rgba(255,255,255,0.05); padding:16px; border-radius:6px; border:1px solid var(--line); display:inline-block;">
        <b style="color:var(--orange);">FLIGHT CONTROLS</b><br/><br/>
        <table style="color:#cbd5e1; border-spacing:8px 4px;">
          <tr><td><b>W / S</b></td><td>: Pitch Up / Down</td></tr>
          <tr><td><b>A / D</b></td><td>: Roll Left / Right</td></tr>
          <tr><td><b>SHIFT / CTRL</b></td><td>: Throttle Up / Down</td></tr>
          <tr><td><b>C</b></td><td>: Toggle Camera View</td></tr>
          <tr><td><b>F</b></td><td>: Toggle Fullscreen</td></tr>
        </table>
      </div>
    </div>
  </div>

  <!-- Streamlined HUD -->
  <div id="planesim-hud" style="display:none; position:absolute; inset:0; pointer-events:none; z-index:5;">
    
    <!-- Reticle -->
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:40px; height:40px;">
      <div style="position:absolute; top:50%; left:0; width:12px; height:2px; background:rgba(0,255,100,0.7); transform:translateY(-50%);"></div>
      <div style="position:absolute; top:50%; right:0; width:12px; height:2px; background:rgba(0,255,100,0.7); transform:translateY(-50%);"></div>
      <div style="position:absolute; top:0; left:50%; width:2px; height:12px; background:rgba(0,255,100,0.7); transform:translateX(-50%);"></div>
      <div style="position:absolute; top:50%; left:50%; width:4px; height:4px; background:rgba(0,255,100,0.9); border-radius:50%; transform:translate(-50%,-50%);"></div>
    </div>

    <!-- Speed Tape (Left) -->
    <div style="position:absolute; left:20px; top:50%; transform:translateY(-50%); width:60px; height:200px; border-left:2px solid rgba(0,255,100,0.5);">
      <div style="position:absolute; top:-25px; left:0; font-family:monospace; color:#0f6; font-size:12px; font-weight:bold;">SPD (kts)</div>
      <div style="position:absolute; top:50%; left:0; width:10px; height:2px; background:#0f6; transform:translateY(-50%);"></div>
      <div id="hud-speed" style="position:absolute; top:50%; left:16px; transform:translateY(-50%); font-family:monospace; color:#0f6; font-size:18px; font-weight:bold; text-shadow:1px 1px 2px #000;">000</div>
    </div>

    <!-- Altitude Tape (Right) -->
    <div style="position:absolute; right:20px; top:50%; transform:translateY(-50%); width:60px; height:200px; border-right:2px solid rgba(0,255,100,0.5);">
      <div style="position:absolute; top:-25px; right:0; font-family:monospace; color:#0f6; font-size:12px; font-weight:bold; text-align:right;">ALT (ft)</div>
      <div style="position:absolute; top:50%; right:0; width:10px; height:2px; background:#0f6; transform:translateY(-50%);"></div>
      <div id="hud-alt" style="position:absolute; top:50%; right:16px; transform:translateY(-50%); font-family:monospace; color:#0f6; font-size:18px; font-weight:bold; text-align:right; text-shadow:1px 1px 2px #000;">0000</div>
    </div>

    <!-- Throttle & Compass (Bottom) -->
    <div style="position:absolute; bottom:20px; left:50%; transform:translateX(-50%); display:flex; gap:40px; font-family:monospace; color:#0f6; font-size:14px; text-shadow:1px 1px 2px #000; font-weight:bold;">
      <div>THR: <span id="hud-thrust">0</span>%</div>
      <div>HDG: <span id="hud-hdg">000</span>°</div>
    </div>

    <!-- Crash Banner -->
    <div id="hud-crash" style="display:none; position:absolute; top:35%; left:50%; transform:translate(-50%,-50%); text-align:center;">
      <h1 style="color:#ff3333; font-family:var(--font-display); font-size:48px; margin:0; text-shadow:2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000;">CRASHED</h1>
      <p style="color:#fff; font-family:monospace; font-size:16px; margin-top:10px; background:rgba(0,0,0,0.5); padding:4px 12px; border-radius:4px;">Press R to Restart</p>
    </div>

    <!-- Fullscreen Hint -->
    <div style="position:absolute; top:10px; right:10px; font-family:monospace; color:rgba(255,255,255,0.4); font-size:10px;">Press [F] for Fullscreen</div>
  </div>

  <canvas id="planesim-canvas" style="width:100%; height:100%; display:block; outline:none;" tabindex="0"></canvas>
</div>

<!-- Load Three.js from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" is:inline></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const startBtn = document.getElementById('planesim-start');
    if (!startBtn) return;

    // Wait until start is clicked to prevent unneeded heavy processing in the background
    startBtn.addEventListener('click', initSim);

    function initSim() {
      document.getElementById('planesim-overlay').style.display = 'none';
      document.getElementById('planesim-hud').style.display = 'block';

      if (typeof THREE === 'undefined') {
        alert('Failed to load 3D engine.');
        return;
      }

      const container = document.getElementById('planesim-container');
      const canvas = document.getElementById('planesim-canvas');
      canvas.focus(); // Capture keyboard
      
      const width = container.clientWidth;
      const height = container.clientHeight;

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false });
      renderer.setSize(width, height);
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      
      // Sky Color
      const skyColor = new THREE.Color(0x76b6e4);
      const scene = new THREE.Scene();
      scene.background = skyColor;
      scene.fog = new THREE.FogExp2(skyColor, 0.00015); // Distance fog

      const camera = new THREE.PerspectiveCamera(60, width / height, 1, 30000);
      let cameraMode = 'chase'; // 'chase' or 'cockpit'

      // Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xfffaed, 1.2);
      dirLight.position.set(2000, 4000, 2000);
      dirLight.castShadow = true;
      // Large shadow map for the chunk around the plane
      dirLight.shadow.camera.left = -2000;
      dirLight.shadow.camera.right = 2000;
      dirLight.shadow.camera.top = 2000;
      dirLight.shadow.camera.bottom = -2000;
      dirLight.shadow.camera.far = 10000;
      dirLight.shadow.mapSize.width = 2048;
      dirLight.shadow.mapSize.height = 2048;
      scene.add(dirLight);

      // --- PROCEDURAL P-51 MUSTANG MODEL ---
      const plane = new THREE.Group();
      
      const metalMat = new THREE.MeshStandardMaterial({ color: 0x999999, roughness: 0.3, metalness: 0.8 });
      const oliveMat = new THREE.MeshStandardMaterial({ color: 0x4a5320, roughness: 0.6 });
      const whiteMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.7 });
      const blackMat = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.8 });
      const glassMat = new THREE.MeshStandardMaterial({ color: 0x223344, roughness: 0.1, metalness: 0.9, transparent: true, opacity: 0.6 });

      // Main Fuselage (long cylinder, tapering at back)
      const fuselageGeo = new THREE.CylinderGeometry(0.8, 1.1, 10, 16);
      fuselageGeo.rotateX(Math.PI / 2);
      const fuselage = new THREE.Mesh(fuselageGeo, metalMat);
      fuselage.castShadow = true;
      fuselage.receiveShadow = true;
      plane.add(fuselage);
      
      // Nose cone
      const noseGeo = new THREE.CylinderGeometry(0.2, 0.8, 2, 16);
      noseGeo.rotateX(Math.PI / 2);
      const nose = new THREE.Mesh(noseGeo, metalMat);
      nose.position.z = 6;
      nose.castShadow = true;
      plane.add(nose);

      // Tail cone
      const tailGeo = new THREE.CylinderGeometry(0.1, 1.1, 4, 16);
      tailGeo.rotateX(Math.PI / 2);
      const tail = new THREE.Mesh(tailGeo, metalMat);
      tail.position.z = -7;
      plane.add(tail);

      // Belly radiator scoop (Iconic P-51 feature)
      const scoopGeo = new THREE.BoxGeometry(1.4, 0.8, 3.5);
      const scoop = new THREE.Mesh(scoopGeo, metalMat);
      scoop.position.set(0, -0.7, -1);
      plane.add(scoop);

      // Wings (Square tipped, invasion stripes)
      const wingGroup = new THREE.Group();
      const mainWingGeo = new THREE.BoxGeometry(18, 0.2, 3);
      const mainWing = new THREE.Mesh(mainWingGeo, metalMat);
      mainWing.castShadow = true;
      wingGroup.add(mainWing);
      
      // Invasion Stripes (White/Black bands on wings)
      const stripeGeo = new THREE.BoxGeometry(1.5, 0.22, 3.01);
      const stripe1 = new THREE.Mesh(stripeGeo, whiteMat); stripe1.position.x = 4; wingGroup.add(stripe1);
      const stripe2 = new THREE.Mesh(stripeGeo, blackMat); stripe2.position.x = 5.5; wingGroup.add(stripe2);
      const stripe3 = new THREE.Mesh(stripeGeo, whiteMat); stripe3.position.x = 7; wingGroup.add(stripe3);
      
      const stripe4 = new THREE.Mesh(stripeGeo, whiteMat); stripe4.position.x = -4; wingGroup.add(stripe4);
      const stripe5 = new THREE.Mesh(stripeGeo, blackMat); stripe5.position.x = -5.5; wingGroup.add(stripe5);
      const stripe6 = new THREE.Mesh(stripeGeo, whiteMat); stripe6.position.x = -7; wingGroup.add(stripe6);

      wingGroup.position.set(0, -0.2, 1.5);
      plane.add(wingGroup);

      // Vertical Stabilizer
      const vStabGeo = new THREE.BoxGeometry(0.2, 3.5, 2.5);
      const vStabVerts = vStabGeo.attributes.position;
      for(let i=0; i<vStabVerts.count; i++) {
        if(vStabVerts.getY(i) > 0) {
          vStabVerts.setZ(i, vStabVerts.getZ(i) - 1.5); // Swept back
          vStabVerts.setX(i, vStabVerts.getX(i) * 0.5); // Taper
        }
      }
      vStabGeo.computeVertexNormals();
      const vStab = new THREE.Mesh(vStabGeo, oliveMat); // Olive drab tail
      vStab.position.set(0, 1.5, -8);
      plane.add(vStab);

      // Horizontal Stabilizer
      const hStabGeo = new THREE.BoxGeometry(6, 0.1, 1.8);
      const hStab = new THREE.Mesh(hStabGeo, metalMat);
      hStab.position.set(0, 0, -8.5);
      plane.add(hStab);

      // Bubble Canopy
      const canopyGeo = new THREE.SphereGeometry(1, 16, 16, 0, Math.PI * 2, 0, Math.PI / 2);
      const canopy = new THREE.Mesh(canopyGeo, glassMat);
      canopy.scale.set(0.8, 1, 2.5);
      canopy.position.set(0, 0.8, 1);
      plane.add(canopy);

      // 4-Blade Propeller
      const propGroup = new THREE.Group();
      propGroup.position.z = 7.1;
      
      const spinnerGeo = new THREE.ConeGeometry(0.4, 0.8, 16);
      spinnerGeo.rotateX(Math.PI/2);
      const spinner = new THREE.Mesh(spinnerGeo, oliveMat);
      spinner.position.z = 0.4;
      propGroup.add(spinner);
      
      const bladeGeo = new THREE.BoxGeometry(0.1, 5, 0.3);
      for(let i=0; i<4; i++) {
        const blade = new THREE.Mesh(bladeGeo, blackMat);
        blade.rotation.z = (Math.PI / 2) * i;
        propGroup.add(blade);
      }
      
      plane.add(propGroup);
      scene.add(plane);

      // --- PROCEDURAL WORLD GENERATION ---
      
      // Simple hash-based 2D noise
      function random(x, z) {
        return Math.sin(x * 12.9898 + z * 78.233) * 43758.5453 % 1;
      }
      function noise(x, z) {
        const ix = Math.floor(x), iz = Math.floor(z);
        const fx = x - ix, fz = z - iz;
        
        const a = random(ix, iz);
        const b = random(ix + 1, iz);
        const c = random(ix, iz + 1);
        const d = random(ix + 1, iz + 1);
        
        const ux = fx * fx * (3 - 2 * fx);
        const uz = fz * fz * (3 - 2 * fz);
        
        return a + (b - a) * ux + (c - a) * uz + (a - b - c + d) * ux * uz;
      }
      function fbm(x, z) {
        let val = 0; let amp = 1; let freq = 1;
        for(let i=0; i<4; i++) {
          val += noise(x * freq, z * freq) * amp;
          amp *= 0.5; freq *= 2;
        }
        return val;
      }

      // Terrain Mesh
      const mapSize = 24000;
      const mapSegments = 150;
      const terrainGeo = new THREE.PlaneGeometry(mapSize, mapSize, mapSegments, mapSegments);
      terrainGeo.rotateX(-Math.PI / 2);
      
      const tPos = terrainGeo.attributes.position;
      const colors = [];
      const colorObj = new THREE.Color();
      
      const treePositions = [];
      const townPositions = [];

      for(let i = 0; i < tPos.count; i++) {
        const vx = tPos.getX(i);
        const vz = tPos.getZ(i);
        
        // Generate height
        // Base low frequency for mountains, subtracted by rivers
        let h = fbm(vx * 0.0001, vz * 0.0001) * 2500 - 500;
        
        // River carving (sine waves cutting into terrain)
        const river1 = Math.abs(Math.sin(vx * 0.0002 + Math.cos(vz * 0.0003))) * 500;
        const river2 = Math.abs(Math.cos(vz * 0.00015 + Math.sin(vx * 0.00025))) * 500;
        h -= (1000 / (river1 + 50)); // Carve deep trenches
        h -= (1000 / (river2 + 50));
        
        // Flatten sea level
        let isWater = false;
        if(h < 0) { h = -20; isWater = true; }
        
        tPos.setY(i, h);

        // Vertex Colors
        if(isWater) {
          colorObj.setHex(0xc2b280); // Sand underneath
        } else if (h > 1200) {
          colorObj.setHex(0xeef2f5); // Snow peaks
        } else if (h > 600) {
          colorObj.setHex(0x546351); // Dark rocky green
        } else {
          colorObj.setHex(0x456a33); // Grass valley
        }
        colors.push(colorObj.r, colorObj.g, colorObj.b);
      }
      
      terrainGeo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
      terrainGeo.computeVertexNormals();
      
      const terrainMat = new THREE.MeshStandardMaterial({ 
        vertexColors: true, 
        roughness: 0.9, 
        flatShading: true 
      });
      const terrain = new THREE.Mesh(terrainGeo, terrainMat);
      terrain.receiveShadow = true;
      scene.add(terrain);

      // Water Plane
      const waterGeo = new THREE.PlaneGeometry(mapSize, mapSize);
      waterGeo.rotateX(-Math.PI / 2);
      const waterMat = new THREE.MeshStandardMaterial({ color: 0x1f5c87, transparent: true, opacity: 0.8, roughness: 0.1 });
      const water = new THREE.Mesh(waterGeo, waterMat);
      water.position.y = 0;
      scene.add(water);

      // Gather spawn points based on face normals and height
      const tNorms = terrainGeo.attributes.normal;
      for(let i=0; i < tPos.count; i++) {
        const h = tPos.getY(i);
        if(h > 10 && h < 600) {
          const ny = tNorms.getY(i);
          if (ny > 0.95) {
            // Flat land -> potential town
            if(Math.random() > 0.98) townPositions.push(new THREE.Vector3(tPos.getX(i), h, tPos.getZ(i)));
          }
          if (ny > 0.85) {
            // Slight slope -> potential tree
            if(Math.random() > 0.6) treePositions.push(new THREE.Vector3(tPos.getX(i), h, tPos.getZ(i)));
          }
        }
      }

      // Biome: Trees (InstancedMesh)
      const treeCount = Math.min(treePositions.length, 15000); // Cap at 15k
      const treeGeo = new THREE.ConeGeometry(8, 24, 4);
      const treeMat = new THREE.MeshStandardMaterial({ color: 0x1e3615, flatShading: true });
      const treeMesh = new THREE.InstancedMesh(treeGeo, treeMat, treeCount);
      const dummy = new THREE.Object3D();
      for(let i=0; i<treeCount; i++) {
        dummy.position.copy(treePositions[i]);
        dummy.position.y += 12; // Half height
        dummy.position.x += (Math.random() - 0.5) * 50;
        dummy.position.z += (Math.random() - 0.5) * 50;
        dummy.rotation.y = Math.random() * Math.PI;
        dummy.scale.setScalar(Math.random() * 0.5 + 0.8);
        dummy.updateMatrix();
        treeMesh.setMatrixAt(i, dummy.matrix);
      }
      scene.add(treeMesh);

      // Biome: Towns (InstancedMesh)
      const townCount = Math.min(townPositions.length, 500); // Clusters of buildings
      const bldgGeo = new THREE.BoxGeometry(30, 40, 30);
      const bldgMat = new THREE.MeshStandardMaterial({ color: 0x888888, flatShading: true });
      const bldgMesh = new THREE.InstancedMesh(bldgGeo, bldgMat, townCount * 5); // 5 buildings per town
      let bldgIdx = 0;
      for(let i=0; i<townCount; i++) {
        const center = townPositions[i];
        for(let b=0; b<5; b++) {
          if (bldgIdx >= townCount * 5) break;
          dummy.position.copy(center);
          dummy.position.x += (Math.random() - 0.5) * 150;
          dummy.position.z += (Math.random() - 0.5) * 150;
          const hScale = Math.random() * 1.5 + 0.5;
          dummy.position.y += 20 * hScale;
          dummy.rotation.y = Math.random() * Math.PI;
          dummy.scale.set(Math.random() * 0.8 + 0.6, hScale, Math.random() * 0.8 + 0.6);
          dummy.updateMatrix();
          bldgMesh.setMatrixAt(bldgIdx++, dummy.matrix);
        }
      }
      scene.add(bldgMesh);

      // --- VOLUMETRIC CLOUDS ---
      const cloudCanvas = document.createElement('canvas');
      cloudCanvas.width = 128;
      cloudCanvas.height = 128;
      const cctx = cloudCanvas.getContext('2d');
      const grad = cctx.createRadialGradient(64,64,0, 64,64,64);
      grad.addColorStop(0, 'rgba(255,255,255,1)');
      grad.addColorStop(0.4, 'rgba(255,255,255,0.7)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      cctx.fillStyle = grad;
      cctx.fillRect(0,0, 128,128);
      
      const cloudTex = new THREE.CanvasTexture(cloudCanvas);
      const cloudMat = new THREE.SpriteMaterial({
        map: cloudTex,
        color: 0xffffff,
        transparent: true,
        opacity: 0.5,
        depthWrite: false,
        blending: THREE.NormalBlending
      });

      const cloudGroup = new THREE.Group();
      for(let i=0; i<600; i++) {
        const sprite = new THREE.Sprite(cloudMat);
        const size = Math.random() * 600 + 400;
        sprite.scale.set(size, size, 1);
        sprite.position.set(
          (Math.random() - 0.5) * 15000,
          Math.random() * 1000 + 1500, // Clouds between 1500 and 2500 altitude
          (Math.random() - 0.5) * 15000
        );
        cloudGroup.add(sprite);
      }
      scene.add(cloudGroup);

      // --- PHYSICS ENGINE ---
      const state = {
        pos: new THREE.Vector3(0, 1000, 0),
        vel: new THREE.Vector3(0, 0, 150),
        quaternion: new THREE.Quaternion(),
        throttle: 0.5,
        pitchInput: 0,
        rollInput: 0,
        crashed: false
      };

      plane.position.copy(state.pos);

      const GRAVITY = 9.81;
      const MASS = 3500; // heavier for P51
      const MAX_THRUST = 70000;
      const WING_AREA = 22;
      const AIR_DENSITY = 1.225;
      
      // Controls
      const keys = {};
      window.addEventListener('keydown', e => {
        if(state.crashed && e.key.toLowerCase() === 'r') {
          resetSim();
          return;
        }

        if(e.key.toLowerCase() === 'f') {
          toggleFullscreen();
          return;
        }

        keys[e.key.toLowerCase()] = true;
        if(e.key.toLowerCase() === 'c') {
          cameraMode = cameraMode === 'chase' ? 'cockpit' : 'chase';
        }
      });
      window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

      function toggleFullscreen() {
        if (!document.fullscreenElement) {
          container.requestFullscreen().catch(err => console.log(err));
        } else {
          document.exitFullscreen();
        }
      }

      function resetSim() {
        state.crashed = false;
        state.pos.set(0, 1000, 0);
        state.vel.set(0, 0, 150);
        state.quaternion.identity();
        state.throttle = 0.5;
        document.getElementById('hud-crash').style.display = 'none';
      }

      const clock = new THREE.Clock();

      // Get Terrain height at X,Z
      function getTerrainHeight(x, z) {
        let h = fbm(x * 0.0001, z * 0.0001) * 2500 - 500;
        const river1 = Math.abs(Math.sin(x * 0.0002 + Math.cos(z * 0.0003))) * 500;
        const river2 = Math.abs(Math.cos(z * 0.00015 + Math.sin(x * 0.00025))) * 500;
        h -= (1000 / (river1 + 50));
        h -= (1000 / (river2 + 50));
        return Math.max(h, 0); // At least 0 (water level)
      }

      function updatePhysics(dt) {
        if(state.crashed) return;

        // Inputs
        if(keys['shift']) state.throttle = Math.min(1, state.throttle + 0.5 * dt);
        if(keys['control']) state.throttle = Math.max(0, state.throttle - 0.5 * dt);
        
        let targetPitch = 0;
        if(keys['w']) targetPitch = 1;  // W = Nose Up
        if(keys['s']) targetPitch = -1; // S = Nose Down
        state.pitchInput = THREE.MathUtils.lerp(state.pitchInput, targetPitch, dt * 5);

        let targetRoll = 0;
        if(keys['a']) targetRoll = 1;   // Roll Left
        if(keys['d']) targetRoll = -1;  // Roll Right
        state.rollInput = THREE.MathUtils.lerp(state.rollInput, targetRoll, dt * 5);

        // Rotation
        const rollQuat = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0,0,1), state.rollInput * 2.5 * dt);
        const pitchQuat = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1,0,0), state.pitchInput * 1.5 * dt);
        
        state.quaternion.multiply(rollQuat);
        state.quaternion.multiply(pitchQuat);
        
        // Coordinated turn approximation
        const euler = new THREE.Euler().setFromQuaternion(state.quaternion, 'YXZ');
        euler.y += euler.z * 0.8 * dt; 
        state.quaternion.setFromEuler(euler);

        plane.quaternion.copy(state.quaternion);

        // Forces
        const forward = new THREE.Vector3(0,0,1).applyQuaternion(state.quaternion);
        const up = new THREE.Vector3(0,1,0).applyQuaternion(state.quaternion);
        
        const speedSq = state.vel.lengthSq();
        const speed = Math.sqrt(speedSq);

        const thrustForce = forward.clone().multiplyScalar(state.throttle * MAX_THRUST);
        const dragForce = state.vel.clone().normalize().multiplyScalar(-0.5 * AIR_DENSITY * speedSq * 0.08); // Lower drag for P51

        const velDir = speed > 0 ? state.vel.clone().normalize() : forward.clone();
        const aoa = forward.dot(velDir);
        const liftForce = up.clone().multiplyScalar(0.5 * AIR_DENSITY * speedSq * WING_AREA * 0.08 * Math.max(0.1, aoa));

        const gravityForce = new THREE.Vector3(0, -MASS * GRAVITY, 0);

        const totalForce = new THREE.Vector3()
          .add(thrustForce)
          .add(dragForce)
          .add(liftForce)
          .add(gravityForce);

        const accel = totalForce.divideScalar(MASS);
        state.vel.add(accel.multiplyScalar(dt));
        state.pos.add(state.vel.clone().multiplyScalar(dt));

        // Crash Detection
        const groundY = getTerrainHeight(state.pos.x, state.pos.z);
        if(state.pos.y < groundY + 2) { // 2m tolerance for gear/fuselage
          state.crashed = true;
          document.getElementById('hud-crash').style.display = 'block';
          // Snap to ground
          state.pos.y = groundY;
          state.vel.set(0,0,0);
        }

        // Loop world boundaries to simulate endless flight
        const halfMap = mapSize / 2;
        if(state.pos.x > halfMap) state.pos.x -= mapSize;
        if(state.pos.x < -halfMap) state.pos.x += mapSize;
        if(state.pos.z > halfMap) state.pos.z -= mapSize;
        if(state.pos.z < -halfMap) state.pos.z += mapSize;

        plane.position.copy(state.pos);

        // Propeller animation (spins even when crashed if engine is on, but let's stop it for dramatic effect)
        propGroup.rotation.z += (state.throttle * 25 + 2) * dt;

        // Cloud billboarding
        cloudGroup.children.forEach(c => {
          c.quaternion.copy(camera.quaternion);
        });

        // HUD Updates
        document.getElementById('hud-thrust').innerText = Math.round(state.throttle * 100);
        document.getElementById('hud-speed').innerText = Math.round(speed * 1.94384); // m/s to knots
        document.getElementById('hud-alt').innerText = Math.round(state.pos.y * 3.28084); // meters to feet
        
        // Heading (0-360)
        let hdg = Math.round(THREE.MathUtils.radToDeg(Math.atan2(forward.x, forward.z)));
        if (hdg < 0) hdg += 360;
        document.getElementById('hud-hdg').innerText = hdg.toString().padStart(3, '0');
      }

      function updateCamera() {
        if(cameraMode === 'chase') {
          const offset = new THREE.Vector3(0, 10, -35);
          offset.applyQuaternion(plane.quaternion);
          const targetPos = plane.position.clone().add(offset);
          camera.position.lerp(targetPos, 0.15); // Smooth follow
          
          const lookTarget = plane.position.clone().add(new THREE.Vector3(0,0,10).applyQuaternion(plane.quaternion));
          camera.lookAt(lookTarget);
        } else {
          // Cockpit view
          const offset = new THREE.Vector3(0, 1.2, -0.5); // Inside bubble canopy
          offset.applyQuaternion(plane.quaternion);
          camera.position.copy(plane.position).add(offset);
          
          const lookTarget = plane.position.clone().add(new THREE.Vector3(0,0.5,50).applyQuaternion(plane.quaternion));
          camera.lookAt(lookTarget);
        }
      }

      window.addEventListener('resize', () => {
        const w = container.clientWidth;
        const h = container.clientHeight;
        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      });

      function animate() {
        requestAnimationFrame(animate);
        const dt = Math.min(clock.getDelta(), 0.1);
        
        updatePhysics(dt);
        updateCamera();
        
        // Optional: Move directional light to simulate moving sun or keep shadows focused
        dirLight.position.set(state.pos.x + 2000, 4000, state.pos.z + 2000);
        dirLight.target = plane;

        renderer.render(scene, camera);
      }

      animate();
    }
  });
</script>
